{
  "model": "opus[1m]",
  "cleanupPeriodDays": 10,
  "desktopSessionCleanupPeriodDays": 10,
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python -B 공통/scripts/receive.py --auto",
            "timeout": 180,
            "statusMessage": "시스템 파일 받는 중"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PROJECT_DIR:-.}/공통/scripts/case_watch.py\" prompt",
            "timeout": 60,
            "statusMessage": "사건 기록 확인 중"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PROJECT_DIR:-.}/공통/scripts/case_watch.py\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
